# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
# Model names must exist on your Groq account. List them with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Vision-capable model used for image + text requests
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Text model used for planning, valuation, chat, advisories
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true to run without any API key (deterministic demo responses)
DEMO_MODE=false
